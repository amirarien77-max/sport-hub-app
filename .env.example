EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# true = in-memory demo data; false = live Supabase (requires URL + anon key).
EXPO_PUBLIC_DEMO_MODE=true
# OpenAI for Game IQ lives in Supabase Edge Function secret OPENAI_API_KEY — not here.
# Twilio for parental SMS lives in Edge Function secrets TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_FROM_NUMBER — not here.
